> # helper: lowest power crossing an R^2 target with negative slope\
> pick_power <- function(sft, target = 0.90, fallback) \{\
+   fi  <- sft$fitIndices\
+   r2  <- -sign(fi[, 3]) * fi[, 2]\
+   ok  <- which(r2 >= target)\
+   if (length(ok) == 0) \{\
+     cat("  no power reaches R^2 =", target, ", falling back to", fallback, "\\n")\
+     return(fallback)\
+   \}\
+   fi[min(ok), 1]\
+ \}\
